PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string

# Optional: override 3-day profile grace window (ms). Default = 259200000 (3 days).
# PROFILE_INCOMPLETE_GRACE_MS=259200000

# Optional (email / uploads)
NOTIFY_EMAIL=
NOTIFY_PASSWORD=
# Display name / From address (defaults: InOut Portal / NOTIFY_EMAIL)
# SENDER_NAME=UC Attendance
# SENDER_EMAIL=admin@urbancode.in

# Preferred on Linode: SendGrid SMTP (avoids Gmail connection timeouts)
# Create key: https://app.sendgrid.com/settings/api_keys  (Mail Send permission)
# Verify sender/domain: https://app.sendgrid.com/settings/sender_auth
# SENDGRID_API_KEY=SG.xxxxx

# Or any custom SMTP relay (Mailgun / SES / Hostinger):
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Attendance reminder emails (Asia/Kolkata cron). Set to false to disable.
# ATTENDANCE_REMINDERS_ENABLED=true

# Lock In-Out at 21:00 Asia/Kolkata when an employee missed check-in, check-out, and leave.
# Only an admin unlock clears it. Set to false to disable.
# MISSED_ATTENDANCE_LOCK_ENABLED=true
# MISSED_ATTENDANCE_LOCK_HOUR=21

# Monthly attendance + payslip emails (1st of month 10:00 Asia/Kolkata). Set to false to disable.
# MONTHLY_REPORTS_ENABLED=true

# Birthday wishes to Google Chat / Slack / Teams incoming webhook (09:00 Asia/Kolkata).
# Paste the chat space incoming webhook URL here. Leave empty to skip posting.
BIRTHDAY_CHAT_WEBHOOK_URL=
# BIRTHDAY_WISHES_ENABLED=true
# Custom message. Placeholders: {name} {firstName} {position} {company} {employeeId}
# Use \n for new lines. If unset, the default Urbancode Edutech birthday wish is used.
# BIRTHDAY_WISH_TEXT=Dear {name},\n\nWishing you a very Happy Birthday! 🎂✨
# Public https:// poster URL (Cloudinary / Hostinger / CDN). Required for image in Chat.
# Webhooks cannot upload files — Google must fetch this URL. Leave empty for text-only.
# BIRTHDAY_POSTER_IMAGE_URL=https://res.cloudinary.com/YOUR_CLOUD/image/upload/v1/birthday-poster.png

# Work anniversary wishes for dateOfJoining (09:05 Asia/Kolkata).
# Use a separate Incoming Webhook name (e.g. Work Anniversary) so Chat does not show "Birthday wish".
JOINING_CHAT_WEBHOOK_URL=
# JOINING_WISHES_ENABLED=true
# Placeholders: {name} {firstName} {position} {company} {employeeId} {years}
# JOINING_WISH_TEXT=Dear {name},\n\nCongratulations on completing {years} year(s) with Urbancode!

# Welcome wish when admin approves a NEW user (existing users are never posted).
# Use a separate Incoming Webhook name (e.g. Welcome) so Chat does not show "Birthday wish".
# Create this webhook inside the UC_JZ_Team Google Chat space.
NEW_USER_CHAT_WEBHOOK_URL=
# NEW_USER_WISHES_ENABLED=true
# Placeholders: {name} {firstName} {position} {company} {employeeId}
# {name} = employee name from InOut. Welcome posts only after they join UC_JZ_Team.
# NEW_USER_WISH_TEXT=_Welcome to Urbancode Edutech Solutions Pvt. Ltd.!_ {name} 🎉\n\nWe are truly delighted...
# How often to check invited users until they join the space (minutes).
# NEW_USER_WELCOME_CHECK_MINUTES=3

# Team invites users manually in UC_JZ_Team. InOut waits until JOINED, then posts welcome.
# GOOGLE_CHAT_JOIN_CHECK_ENABLED=true
# GOOGLE_CHAT_AUTO_INVITE_ENABLED=false
# GOOGLE_CHAT_WELCOME_SPACE_NAME=UC_JZ_Team
# Optional override; otherwise parsed from NEW_USER_CHAT_WEBHOOK_URL (spaces/AAAA...).
# GOOGLE_CHAT_WELCOME_SPACE_ID=AAAA8WZ8dFM
# Workspace admin email to impersonate (must be a manager of the Chat space).
# GOOGLE_CHAT_ADMIN_EMAIL=admin@urbancode.in
# Path to service-account JSON (relative to InOut-backend/) or inline JSON string.
# GOOGLE_CHAT_SERVICE_ACCOUNT_PATH=config/google-chat-service-account.json
# GOOGLE_CHAT_SERVICE_ACCOUNT_JSON=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ASKEVA_API_KEY=
